{
  "name": "majales",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "منصة مجالس — إدارة المجالس العلمية التربوية",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tests.json",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit tests/components",
    "test:db": "vitest run tests/db",
    "db:bundle": "node scripts/build-setup.mjs",
    "db:check": "node scripts/build-setup.mjs --check",
    "test:all": "npm run typecheck && npm run db:check && npm test",
    "dev:design": "node scripts/dev-design.mjs"
  },
  "dependencies": {
    "@fontsource-variable/readex-pro": "^5.3.0",
    "@fontsource/markazi-text": "^5.3.0",
    "@fontsource/noto-naskh-arabic": "^5.3.0",
    "@supabase/supabase-js": "^2.45.4",
    "idb": "^8.0.0",
    "lucide-react": "^1.70.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.5",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.20",
    "fake-indexeddb": "^6.2.7",
    "jsdom": "^26.1.0",
    "pg": "^8.23.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^7.0.2",
    "vite": "^7.3.7",
    "vitest": "^5.1.0"
  }
}
